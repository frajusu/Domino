[gd_resource type="Shader" format=2]

[resource]
code = "shader_type canvas_item;

// Rotación del dominó
uniform float r1 = 0.0;

// Offsets de cada sombra (10)
uniform float offset1;
uniform float offset2;
uniform float offset3;
uniform float offset4;
uniform float offset5;
uniform float offset6;
uniform float offset7;
uniform float offset8;
uniform float offset9;
uniform float offset10;

// Color y fuerza de las sombras
uniform vec4 shadow_color : hint_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float shadow_strength : hint_range(0.0, 1.0) = 0.8;

// Color del sprite original
uniform vec4 original_color : hint_color = vec4(1.0, 1.0, 1.0, 1.0);

// Grosor del dominó (solo el real)
uniform float real_thickness : hint_range(0.7, 50.0) = 1.0;

// Progreso de caída
uniform float fall_progress : hint_range(-4.0,4.0) = 0.0;

void vertex() {
    VERTEX.xy *= 3.0;
}

void fragment() {
    mat2 scale_matrix = mat2(vec2(1.0, 0.0), vec2(0.0, TEXTURE_PIXEL_SIZE.x / TEXTURE_PIXEL_SIZE.y));
    vec2 uv_orig = (((UV*2.0-1.0)*3.0+1.0)/2.0-vec2(0.5))*scale_matrix;

    // Vector de dirección según rotación
    vec2 fall_dir = -vec2(cos(r1), sin(r1));

    // Array de offsets
    float offsets[10] = float[10](offset1,offset2,offset3,offset4,offset5,offset6,offset7,offset8,offset9,offset10);

    // Detectar la sombra más alta (para que las de arriba queden fijas)
    float max_offset = offsets[0];
    for(int i=1;i<10;i++){
        if(offsets[i]>max_offset) max_offset = offsets[i];
    }

    // Rotación del dominó
    mat2 rot = mat2(vec2(cos(r1), sin(r1)), vec2(-sin(r1), cos(r1)));

    // Calcular UVs de sombras
    vec2 uv_shadow[10];
    for(int i=0;i<10;i++){
        // Solo las sombras más bajas se mueven
        float move_factor = max(0.0, max_offset - offsets[i]);
        vec2 dynamic_offset = vec2(0.0, offsets[i]) + fall_dir * move_factor * fall_progress * 0.5;
        uv_shadow[i] = (uv_orig * rot + dynamic_offset * rot) * inverse(scale_matrix) + vec2(0.5);
    }

    // Sprite original con grosor ajustable
    vec2 uv_normal = uv_orig * rot * inverse(scale_matrix) + vec2(0.5);
    uv_normal.x = 0.5 + (uv_normal.x - 0.5) * real_thickness; // Solo ancho

    // Inicializamos sombras y sprite
    vec4 shadow[10];
    for(int i=0;i<10;i++) shadow[i]=vec4(0.0);
    vec4 real=vec4(0.0);

    // Calculamos cada sombra
    for(int i=0;i<10;i++){
        if(uv_shadow[i].x>=0.0 && uv_shadow[i].x<=1.0 && uv_shadow[i].y>=0.0 && uv_shadow[i].y<=1.0){
            vec4 c=texture(TEXTURE, uv_shadow[i]);
            shadow[i] = vec4(shadow_color.rgb, shadow_color.a * c.a * shadow_strength);
        }
    }

    // Sprite original
    if(uv_normal.x>=0.0 && uv_normal.x<=1.0 && uv_normal.y>=0.0 && uv_normal.y<=1.0){
        real = texture(TEXTURE, uv_normal) * original_color;
    }

    // Combinamos todas las sombras
    vec4 combined_shadow = shadow[0];
    for(int i=1;i<10;i++){
        combined_shadow = max(combined_shadow, shadow[i]);
    }

    // Composición final
    COLOR = mix(combined_shadow, real, real.a);
}
"
