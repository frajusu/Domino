[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform sampler2D noise_tex;

uniform float move_speed = 1.0;
uniform float noise_strength = 2.0;

uniform vec4 colour_1 : hint_color;
uniform vec4 colour_2 : hint_color;
uniform vec4 colour_3 : hint_color;
uniform float contrast = 3.5;
uniform float lighting = 0.4;

uniform int amount = 40; // pixelado en screen space

uniform vec2 offset = vec2(0.0, 0.0); // desplazamiento del fondo

vec4 effect(vec2 uv_coords){

    vec2 uv = uv_coords * 30.0;

    vec2 n = texture(
        noise_tex,
        fract(uv_coords + TIME * move_speed)
    ).rg * 2.0 - 1.0;

    uv += n * noise_strength;

    vec2 uv2 = vec2(uv.x + uv.y);

    for(int i = 0; i < 5; i++){
        uv2 += sin(max(uv.x, uv.y)) + uv;
        uv  += 0.5 * vec2(
            cos(5.11 + 0.353 * uv2.y),
            sin(uv2.x)
        );
        uv  -= cos(uv.x + uv.y) - sin(uv.x * 0.711 - uv.y);
    }

    float paint_res = min(2.0, length(uv) * 0.035 * contrast);
    float c1p = max(0.0, 1.0 - contrast * abs(1.0 - paint_res));
    float c2p = max(0.0, 1.0 - contrast * abs(paint_res));
    float c3p = 1.0 - min(1.0, c1p + c2p);

    vec4 col =
        colour_1 * c1p +
        colour_2 * c2p +
        colour_3 * c3p;

    col.rgb += lighting;
    return col;
}

void fragment(){
    // screen space
    vec2 uv = SCREEN_UV;

    // aplicar offset (camara virtual)
    uv += offset;

    // pixelado global
    vec2 pixel_uv = round(uv * float(amount)) / float(amount);

    COLOR = effect(pixel_uv);
}
"

