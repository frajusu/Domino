[sub_resource type="Shader" id=210]
code = "shader_type canvas_item;

uniform vec4 from_color : hint_color = vec4(1.0, 0.0, 0.0, 1.0);
uniform vec4 to_color   : hint_color = vec4(0.0, 1.0, 0.0, 1.0);
uniform float tolerance = 0.3;

uniform float hole_radius = 0.25;
uniform float hole_feather = 0.05;

// NUEVO: region del sprite en UV
uniform vec2 region_pos  = vec2(0.0, 0.0);
uniform vec2 region_size = vec2(1.0, 1.0);

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);

    float d = distance(tex_color.rgb, from_color.rgb);
    if (d < tolerance) {
        tex_color.rgb = to_color.rgb;
    }

    // Centro REAL dentro del region_rect
    vec2 center = region_pos + region_size * 0.5;

    float dist_from_center = distance(UV, center);

    float hole_mask = smoothstep(hole_radius, hole_radius + hole_feather,
                                 dist_from_center);

    tex_color.a *= hole_mask;

    COLOR = tex_color;
}
"

