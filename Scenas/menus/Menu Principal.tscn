[sub_resource type="Shader" id=192]
code = "shader_type canvas_item;

uniform float pixel_size = 8.0;
uniform bool enabled = true;

uniform bool force_color = false;
uniform vec4 forced_color : hint_color = vec4(1.0);

// left, top, right, bottom (en pixeles del 9patch)
uniform vec4 margins = vec4(16.0, 16.0, 16.0, 16.0);

void fragment() {
	vec4 base_color;
	vec2 tex_size = 1.0 / TEXTURE_PIXEL_SIZE;
	vec2 pos = UV * tex_size;

	bool in_margin =
		pos.x < margins.x ||
		pos.x > tex_size.x - margins.z ||
		pos.y < margins.y ||
		pos.y > tex_size.y - margins.w;

	if (enabled && !in_margin) {
		float ps = max(1.0, pixel_size);

		vec2 uv_pixels = floor(pos / ps) * ps + vec2(ps * 0.5);
		vec2 uv_snapped = uv_pixels / tex_size;

		base_color = texture(TEXTURE, uv_snapped);
	} else {
		base_color = texture(TEXTURE, UV);
	}

	// -------------------------------
	//   FORZAR COLOR SIN TOCAR TRANSPARENCIA
	// -------------------------------
	if (force_color && base_color.a > 0.0) {
		// mantiene alpha original pero fuerza color
		base_color.rgb = forced_color.rgb;
		base_color.a = 1.0; // como pediste
	}

	COLOR = base_color * COLOR;
}
"

