[sub_resource type="Shader" id=131]
code = "shader_type canvas_item;

uniform vec4 to_color : hint_color = vec4(0.0, 0.0, 0.0, 1.0); // color de reemplazo

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);

    // reemplaza el color pero conserva el alfa de la textura
    COLOR = vec4(to_color.rgb, tex_color.a);
}
"

[sub_resource type="ShaderMaterial" id=292]
shader = SubResource( 131 )
shader_param/to_color = Color( 0.168627, 0.372549, 0.286275, 1 )

[sub_resource type="ShaderMaterial" id=296]

[sub_resource type="Shader" id=4]
code = "shader_type canvas_item;

uniform vec4 from_color : hint_color = vec4(1.0, 0.0, 0.0, 1.0); // color a reemplazar
uniform vec4 to_color : hint_color = vec4(0.0, 1.0, 0.0, 1.0);   // color de reemplazo
uniform float tolerance = 0.05; // tolerancia en distancia de color (0..1)

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);
    
    // distancia entre colores RGB
    float d = distance(tex_color.rgb, from_color.rgb);
    
    // si esta dentro de la tolerancia, reemplaza
    if (d < tolerance) {
        tex_color.rgb = to_color.rgb;
        tex_color.a = tex_color.a; // preserva alfa original
    }

    COLOR = tex_color;
}
"

[sub_resource type="ShaderMaterial" id=297]
shader = SubResource( 4 )
shader_param/from_color = Color( 0.101961, 0.278431, 0.211765, 1 )
shader_param/to_color = Color( 0.0901961, 0.564706, 0.396078, 1 )
shader_param/tolerance = 0.05

[sub_resource type="Shader" id=121]
code = "shader_type canvas_item;

uniform vec4 color_target : hint_color = vec4(1.0, 0.0, 0.0, 1.0); // color final que queremos

void fragment() {
    vec4 tex = texture(TEXTURE, UV);
    
    // multiplicamos el color original por el target
    // esto preserva la transparencia
    COLOR = vec4(color_target.rgb, tex.a) * tex.a;
}
"

[sub_resource type="ShaderMaterial" id=298]
shader = SubResource( 121 )
shader_param/color_target = Color( 0, 0, 0, 1 )

