[sub_resource type="Shader" id=79]
code = "shader_type canvas_item;

uniform int amount = 40;
uniform float corner_scale: hint_range(0., 1.) = 0.;

bool isOut(float x, float y) {
	return pow(x, 2.) + pow(y, 2.) > pow(corner_scale * .5, 2.);
}

void fragment(){
	
	vec2 grid_uv = round(UV * float(amount)) / float(amount);
	
	vec4 text = texture(TEXTURE, grid_uv);
	
	COLOR = text;
	
	float s = corner_scale * .5;
	if (
		(grid_uv.x < s      && grid_uv.y < s      && isOut(grid_uv.x - s,      grid_uv.y - s)) ||
		(grid_uv.x < s      && grid_uv.y > 1. - s && isOut(grid_uv.x - s,      grid_uv.y - 1. + s)) ||
		(grid_uv.x > 1. - s && grid_uv.y < s      && isOut(grid_uv.x - 1. + s, grid_uv.y - s)) ||
		(grid_uv.x > 1. - s && grid_uv.y > 1. - s && isOut(grid_uv.x - 1. + s, grid_uv.y - 1. + s))
	) {
		COLOR.a = 0.;
	}
	
}


"

