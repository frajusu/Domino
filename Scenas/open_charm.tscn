[sub_resource type="Shader" id=31]
code = "shader_type canvas_item;

uniform float radius : hint_range(0.0, 1.0) = 0.4;      // radio del circulo
uniform float softness : hint_range(0.0, 1.0) = 0.25;  // cuanto suaviza el borde
uniform float alpha : hint_range(0.0, 1.0) = 1.0;      // opacidad maxima

void fragment() {
    // centro en UV (0.5, 0.5)
    float dist = distance(UV, vec2(0.5));

    // borde suave del circulo
    float circle = 1.0 - smoothstep(radius, radius + softness, dist);

    // color negro con alpha degradado
    COLOR = vec4(0.0, 0.0, 0.0, circle * alpha);
}
"

[sub_resource type="ShaderMaterial" id=30]
