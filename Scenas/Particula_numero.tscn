[sub_resource type="Shader" id=84]
code = "shader_type canvas_item;

// Radio en píxeles, configurable
uniform float radius_px : hint_range(0.0, 256.0, 1.0) = 16.0;
uniform bool rounded_corner_top_left = true;
uniform bool rounded_corner_top_right = true;
uniform bool rounded_corner_bottom_left = true;
uniform bool rounded_corner_bottom_right = true;

uniform int amount = 40;

// Tamaño real del rectángulo (lo seteás desde GDScript con rect_size)
uniform vec2 rect_size = vec2(64.0, 64.0);

// Nuevas variables
uniform vec4 flash_color : hint_color = vec4(1.0);
uniform float flash_modifier : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 grid_uv = round(UV * float(amount)) / float(amount);
	vec4 image = texture(TEXTURE, grid_uv);
	
	// Pasamos UV (0–1) a coordenadas locales en píxeles
	vec2 pos = grid_uv * rect_size;

	float dist;
	
	// Top left
	if (rounded_corner_top_left) {
		dist = length(pos - vec2(radius_px, radius_px));
		if (dist > radius_px && pos.x < radius_px && pos.y < radius_px) {
			image.a = 0.0;
		}
	}
	// Top right
	if (rounded_corner_top_right) {
		dist = length(pos - vec2(rect_size.x - radius_px, radius_px));
		if (dist > radius_px && pos.x > rect_size.x - radius_px && pos.y < radius_px) {
			image.a = 0.0;
		}
	}
	// Bottom left
	if (rounded_corner_bottom_left) {
		dist = length(pos - vec2(radius_px, rect_size.y - radius_px));
		if (dist > radius_px && pos.x < radius_px && pos.y > rect_size.y - radius_px) {
			image.a = 0.0;
		}
	}
	// Bottom right
	if (rounded_corner_bottom_right) {
		dist = length(pos - vec2(rect_size.x - radius_px, rect_size.y - radius_px));
		if (dist > radius_px && pos.x > rect_size.x - radius_px && pos.y > rect_size.y - radius_px) {
			image.a = 0.0;
		}
	}

	// Mezcla el color original con el flash
	image.rgb = mix(image.rgb, flash_color.rgb, flash_modifier);
	image.a *= mix(1.0, flash_color.a, flash_modifier);

	COLOR = image;
}
"

