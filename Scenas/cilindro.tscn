[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform float altura1 : hint_range(0.0, 1.0);

uniform float wave_amp = 0.05;
uniform float wave_speed = 2.0;
uniform float wave_freq = 8.0;

uniform vec4 color_liquido : hint_color;

// -------------------------
// BORDES
// -------------------------
uniform float borde_redondo = 0.12;
uniform float borde_redondo2 = 0.06;
uniform vec4 color_borde2 : hint_color;
uniform float borde2_size = 0.05;

// -------------------------
// NOISE
// -------------------------
uniform sampler2D noise_tex;
uniform int noise_bandas = 3;
uniform float noise_intensidad = 0.25;
uniform float noise_suavidad = 0.2;

uniform vec4 noise_color1 : hint_color;
uniform vec4 noise_color2 : hint_color;
uniform vec4 noise_color3 : hint_color;

// -------------------------
// PIXELACION
// -------------------------
uniform int pixel_size = 4;


// =====================================================
// FUNCION EXTRA – PIXELAR UV sin romper la lógica
// =====================================================
vec2 pixelate(vec2 uv) {
	ivec2 size = textureSize(noise_tex, 0);
	int xRes = size.x;
	int yRes = size.y;

	float xFactor = float(xRes) / float(pixel_size);
	float yFactor = float(yRes) / float(pixel_size);

	float px = round(uv.x * xFactor) / xFactor;
	float py = round(uv.y * yFactor) / yFactor;

	return vec2(px, py);
}



void fragment() {

	// =====================================================
	// APLICAMOS PIXELACION SOLO A UV
	// =====================================================
	vec2 uv = pixelate(UV);


	float altura = (altura1 - 0.2) * 1.4;

	// -------------------------
	// SUPERFICIE ONDULADA
	// -------------------------
	float wave = sin(uv.x * wave_freq + TIME * wave_speed) * wave_amp;
	float h = altura + wave;

	// -------------------------
	// BORDE CURVO SUPERIOR
	// -------------------------
	float curva1 = borde_redondo * sqrt(1.0 - pow((uv.x - 0.5) * 2.0, 2.0));
	float superficie = h + curva1;

	// Segundo borde hacia abajo
	float curva2 = borde_redondo2 * sqrt(1.0 - pow((uv.x - 0.5) * 2.0, 2.0));
	float superficie2 = superficie - curva2;

	if (uv.y < 1.0 - superficie) {
		discard;
	}

	vec4 col = color_liquido;

	// -------------------------
	// INTERSECCION BORDE 2
	// -------------------------
	float y_rel = 1.0 - uv.y;

	if (y_rel > superficie2 && y_rel <= superficie) {
		float f = (superficie - y_rel) / (superficie - superficie2);
		col = mix(color_borde2, color_liquido, f);
	}

	// -------------------------
	// NOISE POR BANDAS
	// -------------------------
	if (y_rel < superficie2) {

		vec2 noise_uv = uv * 2.5 + TIME * 0.05;
		noise_uv = pixelate(noise_uv);   // pixelado también al noise

		float n = texture(noise_tex, noise_uv).r;

		n = mix(0.5, n, noise_intensidad);

		float frac = clamp((superficie2 - y_rel) / superficie2, 0.0, 1.0);
		float paso = 1.0 / float(noise_bandas);

		vec4 noise_col = col;

		if (frac < paso) {
			float t = smoothstep(0.0, noise_suavidad, frac / paso);
			noise_col = mix(col, noise_color1, n * t);

		} else if (frac < paso * 2.0) {
			float v = (frac - paso) / paso;
			float t = smoothstep(0.0, noise_suavidad, v);
			noise_col = mix(col, noise_color2, n * t);

		} else {
			float v = (frac - paso * 2.0) / paso;
			float t = smoothstep(0.0, noise_suavidad, v);
			noise_col = mix(col, noise_color3, n * t);
		}

		col = noise_col;
	}

	// -------------------------
	// GRADIENTE FINAL
	// -------------------------
	float depth = (uv.y - (1.0 - superficie)) / superficie;
	col.rgb *= mix(1.1, 0.8, depth);

	COLOR = col;
}
"

