[sub_resource type="Shader" id=300]
code = "shader_type canvas_item;

uniform int width : hint_range(0, 5, 1);
uniform vec4 outline_color : hint_color;
uniform float flickering_speed : hint_range(0.0, 50.0, 1.);
uniform float minimal_flickering_alpha : hint_range(0.0, 0.9, 0.1);

void fragment() {
	vec4 tex = texture(TEXTURE, UV);

	bool draw_outline = false;
	vec4 final_color = vec4(0.0);

	// Tamaño del pixel
	vec2 pixel_size = 1.0 / vec2(textureSize(TEXTURE, 0));

	// 1) Si el pixel original es visible → se dibuja tal cual
	if (tex.a > 0.0) {
		final_color = tex;
	} 
	else {
		// 2) Buscar vecinos opacos
		for (int x = -width; x <= width; x++) {
			for (int y = -width; y <= width; y++) {

				vec2 offset = vec2(float(x), float(y)) * pixel_size;
				vec4 neigh = texture(TEXTURE, UV + offset);

				if (neigh.a > 0.0) {
					draw_outline = true;
				}
			}
		}

		if (draw_outline) {
			float alpha_norm = (sin(TIME * flickering_speed) + 1.2) * 0.5;
			alpha_norm = mix(minimal_flickering_alpha, 1.0, alpha_norm);

			final_color = outline_color;
			final_color.a = alpha_norm;
		}
		else {
			// 3) Pixel vacío de verdad → completamente transparente
			final_color = vec4(0.0);
		}
	}

	COLOR = final_color;
}
"

