[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform float transparencia : hint_range(0.0, 1.0) = 0.5;
uniform float fuerza_onda : hint_range(0.0, 10.0) = 3.0;
uniform float velocidad_onda : hint_range(0.0, 10.0) = 1.5;
uniform float frecuencia_bandas : hint_range(1.0, 30.0) = 10.0;

// Paleta fantasmal ordenada de oscuro ➜ claro
const vec3 PAL[12] = vec3[](
	vec3(0.184, 0.196, 0.364),
	vec3(0.224, 0.271, 0.427),
	vec3(0.259, 0.345, 0.475),
	vec3(0.286, 0.420, 0.514),
	vec3(0.318, 0.490, 0.569),
	vec3(0.322, 0.549, 0.624),
	vec3(0.329, 0.635, 0.584),
	vec3(0.439, 0.737, 0.576),
	vec3(0.549, 0.835, 0.537),
	vec3(0.718, 0.878, 0.592),
	vec3(0.855, 0.937, 0.671),
	vec3(0.945, 0.949, 0.714)
);

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	if (tex.a <= 0.001) discard;

	// Normalizar alpha
	tex.a = clamp(tex.a, 0.0, 1.0);

	// --- NUEVO: calcular brillo ignorando alpha ---
	vec3 color_rgb = tex.rgb / max(tex.a, 0.001); // evita oscurecer blancos semitransparentes
	color_rgb = clamp(color_rgb, 0.0, 1.0);
	float brillo = (color_rgb.r + color_rgb.g + color_rgb.b) / 3.0;

	// Paleta interpolada
	float idx = brillo * float(PAL.length() - 1);
	int i = int(floor(idx));
	int j = min(i + 1, PAL.length() - 1);
	float t = idx - float(i);
	vec3 fantasma = mix(PAL[i], PAL[j], t);

	// Distorsión tipo CRT
	float offset = sin(UV.y * frecuencia_bandas + TIME * velocidad_onda) * (fuerza_onda / 100.0);
	vec2 uv_dist = UV + vec2(offset, 0.0);
	vec4 tex2 = texture(TEXTURE, uv_dist);

	// Aplicar color final
	float alpha_final = clamp(tex2.a, 0.0, 1.0) * transparencia;
	COLOR = vec4(fantasma, alpha_final);
}

"

[sub_resource type="ShaderMaterial" id=2]
shader = SubResource( 1 )
