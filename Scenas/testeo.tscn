[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.0;
uniform bool invert = false;
uniform bool use_sprite_alpha = true;

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	float alpha = tex.a;

	// Centro vertical
	float center = 0.5;

	// Distancia vertical desde el centro
	float dist = abs(UV.y - center);

	// Borde que se abre desde los bordes hacia el centro
	float edge = mix(0.5, 0.0, progress);

	// Aparece desde arriba y abajo hacia el centro
	float transition = 1.0 - step(dist, edge);

	// Invertir si se desea
	if (invert) transition = 1.0 - transition;

	alpha = use_sprite_alpha ? min(alpha, transition) : transition;

	COLOR = vec4(tex.rgb, alpha);
}
"

