[sub_resource type="Shader" id=3]
code = "shader_type canvas_item;

uniform float progress1 : hint_range(0.0, 0.8) = 0.0;
uniform bool invert = false;
uniform bool use_sprite_alpha = true;
uniform float curvature : hint_range(0.0, 1.0) = 0.3; // cuanto se curva (0 = recto, 1 = muy arqueado)

void fragment() {
	float progress = progress1;
	if (!(progress1+0.16>1.0)) progress = progress1+0.16;
	
	vec4 tex = texture(TEXTURE, UV);
	float alpha = tex.a;

	// Centro vertical
	float center = 0.5;

	// Aplicar curvatura en forma circular
	// Aumenta la distancia según la posición horizontal (UV.x)
	float curved_y = UV.y;
	float curve = pow(abs(UV.x - 0.5) * 2.0, 2.0) * curvature; 
	curved_y += (UV.y < center ? curve : -curve);

	// Nueva distancia usando la coordenada curvada
	float dist = abs(curved_y - center);

	// Borde que se abre desde arriba y abajo hacia el centro
	float edge = mix(0.5, 0.0, progress);
	float transition = 1.0 - step(dist, edge);

	// Invertir si se desea
	if (invert) transition = 1.0 - transition;

	alpha = use_sprite_alpha ? min(alpha, transition) : transition;
	COLOR = vec4(tex.rgb, alpha);
}
"

