[sub_resource type="Shader" id=94]
code = "shader_type canvas_item;

uniform vec4 shine_color : hint_color = vec4(1.0);
uniform float shine_size : hint_range(0.01, 1.0, 0.01) = 0.1;
uniform float shine_angle : hint_range(0.0, 360.0, 0.1) = 45.0;
uniform float shine_speed : hint_range(0.1, 10.0, 0.1) = 1.0;
uniform float shine_delay : hint_range(0.0, 10.0, 0.1) = 2.0;

uniform float pixel_size : hint_range(1.0, 32.0, 1.0) = 4.0;
uniform vec2 sprite_size = vec2(256.0, 256.0); // ⚠️ Setealo desde GDScript

float scale(float value, float inMin, float inMax, float outMin, float outMax) {
    return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin;
}

void fragment() {
    // --- Pixelado consistente ---
    vec2 uv = UV;
    uv = floor(uv * sprite_size / pixel_size) * pixel_size / sprite_size;

    vec4 base_color = texture(TEXTURE, uv);
    COLOR = base_color;

    // --- Brillo animado ---
    float angle_rad = radians(shine_angle);
    vec2 dir = vec2(cos(angle_rad), sin(angle_rad));

    vec2 uv_centered = uv - vec2(0.5);
    float proj = dot(uv_centered, dir);
    float max_proj = length(vec2(0.5, 0.5)) * 2.0;

    float cycle_time = (1.0 / shine_speed) + shine_delay;
    float t = mod(TIME, cycle_time);
    float shine_progress = clamp(t * shine_speed, 0.0, 1.0);

    float progress = scale(shine_progress, 0.0, 1.0, -max_proj - shine_size, max_proj + shine_size);
    float shine = step(proj, progress + shine_size) - step(proj, progress);

    COLOR.rgb = mix(COLOR.rgb, shine_color.rgb, shine * shine_color.a);
}
"

