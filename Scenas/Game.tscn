[sub_resource type="Shader" id=6]
code = "shader_type canvas_item;

uniform float velocidad = 20.184;
uniform float tamano_punto = 3.421;
uniform vec2 tile_pixel_size = vec2(16.0, 16.0);
uniform float color : hint_range(0.0, 1.0); // 0=negro, 0.5=original, 1=blanco
uniform int borde_pixels = 1;
uniform float alpha_umbral = 0.9;

void fragment(){
    vec2 tex_size = vec2(textureSize(TEXTURE, 0));
    vec2 tile_uv_size = tile_pixel_size / tex_size;

    vec2 tile_index = floor(UV / tile_uv_size);
    vec2 tile_origin = tile_index * tile_uv_size;
    vec2 local_uv = (UV - tile_origin) / tile_uv_size;

    if(local_uv.x < 0.0 || local_uv.x > 1.0 || local_uv.y < 0.0 || local_uv.y > 1.0)
        discard;

    float dx = 1.0 / tile_pixel_size.x;
    float dy = 1.0 / tile_pixel_size.y;
    vec2 px = tile_uv_size * vec2(dx, dy);

    float center = texture(TEXTURE, UV).a;
    if(center <= 0.0)
        discard;

    float borde = 0.0;

    for(int i = 1; i <= borde_pixels; i++){
        vec2 off = vec2(float(i) * px.x, float(i) * px.y);

        float left  = texture(TEXTURE, UV + vec2(-off.x, 0.0)).a;
        float right = texture(TEXTURE, UV + vec2( off.x, 0.0)).a;
        float up    = texture(TEXTURE, UV + vec2(0.0, -off.y)).a;
        float down  = texture(TEXTURE, UV + vec2(0.0,  off.y)).a;

        if(left < alpha_umbral || right < alpha_umbral || up < alpha_umbral || down < alpha_umbral){
            borde = 1.0;
            break;
        }
    }

    // ================================
    //     LINEA PUNTEADA PIXEL PERFECT
    // ================================
    vec2 pixel = floor(local_uv * tile_pixel_size);

    float t = TIME * velocidad;

    float linea = mod(pixel.x + pixel.y + t, tamano_punto);
    float punteado = step(tamano_punto * 0.5, linea);

    float final = borde * punteado;

    if(final > 0.0){
        vec4 base_color = texture(TEXTURE, UV);

        // mapeo 0 → negro, 0.5 → original, 1 → blanco
        vec3 final_color;
        if (color < 0.5) {
            float t2 = color / 0.5;
            final_color = mix(vec3(0.0), base_color.rgb, t2);
        } else {
            float t2 = (color - 0.5) / 0.5;
            final_color = mix(base_color.rgb, vec3(1.0), t2);
        }

        COLOR.rgb = final_color;
        COLOR.a = final;
    } else {
        discard;
    }
}
"

