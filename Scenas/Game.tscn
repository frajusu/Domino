[sub_resource type="Shader" id=179]
code = "shader_type canvas_item;

uniform bool usar = true;

uniform vec4 src_color1 : hint_color;
uniform vec4 src_color2 : hint_color;
uniform vec4 src_color3 : hint_color;
uniform vec4 src_color4 : hint_color;
uniform vec4 src_color5 : hint_color;

uniform vec4 dst_color1 : hint_color;
uniform vec4 dst_color2 : hint_color;
uniform vec4 dst_color3 : hint_color;
uniform vec4 dst_color4 : hint_color;
uniform vec4 dst_color5 : hint_color;

uniform float tolerance : hint_range(0.0, 1.0) = 0.02;

void fragment() {
    vec4 col = texture(TEXTURE, UV);

    // si el bool es false → no recolorea nada
    if (usar) {
        float t = tolerance;

        if (distance(col.rgb, src_color1.rgb) <= t) {
            col.rgb = dst_color1.rgb;
        }
        else if (distance(col.rgb, src_color2.rgb) <= t) {
            col.rgb = dst_color2.rgb;
        }
        else if (distance(col.rgb, src_color3.rgb) <= t) {
            col.rgb = dst_color3.rgb;
        }
        else if (distance(col.rgb, src_color4.rgb) <= t) {
            col.rgb = dst_color4.rgb;
        }
        else if (distance(col.rgb, src_color5.rgb) <= t) {
            col.rgb = dst_color5.rgb;
        }
    }

    COLOR = col;
}
"

