[sub_resource type="Shader" id=296]
code = "shader_type canvas_item;

uniform vec4 from_color : hint_color = vec4(1.0, 0.0, 0.0, 1.0); // color a reemplazar
uniform vec4 to_color : hint_color = vec4(0.0, 1.0, 0.0, 1.0);   // color de reemplazo

uniform vec4 from_color1 : hint_color = vec4(1.0, 0.0, 0.0, 1.0); // color a reemplazar
uniform vec4 to_color1 : hint_color = vec4(0.0, 1.0, 0.0, 1.0);   // color de reemplazo

uniform float tolerance = 0.05; // tolerancia en distancia de color (0..1)

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);
    
    // distancia entre colores RGB
    float d = distance(tex_color.rgb, from_color.rgb);
    
    // si esta dentro de la tolerancia, reemplaza
    if (d < tolerance) {
        tex_color.rgb = to_color.rgb;
        tex_color.a = tex_color.a; // preserva alfa original
    }
    
    // distancia entre colores RGB
    float d1 = distance(tex_color.rgb, from_color1.rgb);
    
    // si esta dentro de la tolerancia, reemplaza
    if (d1 < tolerance) {
        tex_color.rgb = to_color1.rgb;
        tex_color.a = tex_color.a; // preserva alfa original
    }


    COLOR = tex_color;
}
"

