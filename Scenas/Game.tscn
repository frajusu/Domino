[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

// -------------------------
// CUADRADO NEGRO GENERAL
// -------------------------
uniform float alpha_fondo : hint_range(0.0, 1.0) = 0.8;

// -------------------------
// CUADRADO INTERIOR
// -------------------------
uniform vec2 inner_pos = vec2(0.25, 0.25);
uniform vec2 inner_size = vec2(0.5, 0.5);
uniform float borde_redondo : hint_range(0.0, 0.5) = 0.08;

// -------------------------
// PIXELADO
// -------------------------
uniform float pixel_size : hint_range(1.0, 512.0) = 1.0;

// -------------------------
// SDF RECT REDONDEADO
// -------------------------
float rect_round(vec2 p, vec2 size, float radius) {
	vec2 d = abs(p) - size + radius;
	return min(max(d.x, d.y), 0.0) + length(max(d, 0.0)) - radius;
}

void fragment() {

	// -------------------------
	// UV PIXELADAS
	// -------------------------
	vec2 uv = UV;
	if (pixel_size > 1.0) {
		uv = floor(uv * pixel_size) / pixel_size;
	}

	// -------------------------
	// CORRECCION ASPECT RATIO
	// -------------------------
	float ratio = TEXTURE_PIXEL_SIZE.y / TEXTURE_PIXEL_SIZE.x;
	uv.x *= ratio;

	// -------------------------
	// COLOR BASE
	// -------------------------
	vec4 color = vec4(0.0, 0.0, 0.0, alpha_fondo);

	// -------------------------
	// RECTANGULO INTERIOR
	// -------------------------
	vec2 center = inner_pos + inner_size * 0.5;
	center.x *= ratio;

	vec2 size = inner_size;
	size.x *= ratio;

	vec2 p = uv - center;
	float dist = rect_round(p, size * 0.5, borde_redondo);

	// Interior transparente
	if (dist < 0.0) {
		color.a = 0.0;
	}

	COLOR = color;
}
"

