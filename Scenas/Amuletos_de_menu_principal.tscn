shader_param/outline_size = 1
shader_param/original_color = Color( 1, 1, 1, 1 )

[sub_resource type="Shader" id=16]
code = "shader_type canvas_item;

uniform vec4 tint_color : hint_color;
uniform float tint_amount : hint_range(0.0, 1.0) = 0.0;

uniform vec4 border_color : hint_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float border_thickness = 0.01;

bool is_out(vec2 uv) {
    return uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0;
}

// pasamos la textura como argumento
float sample_alpha(sampler2D tex, vec2 uv) {
    if (is_out(uv)) {
        return 0.0;
    }
    return texture(tex, uv).a;
}

void fragment() {
    vec4 col = texture(TEXTURE, UV);

    if (col.a >= 0.99) {

        // tintado
        col.rgb = mix(col.rgb, tint_color.rgb, tint_amount);

        // vecinos
        float up    = sample_alpha(TEXTURE, UV + vec2(0.0,  border_thickness));
        float down  = sample_alpha(TEXTURE, UV + vec2(0.0, -border_thickness));
        float left  = sample_alpha(TEXTURE, UV + vec2(-border_thickness, 0.0));
        float right = sample_alpha(TEXTURE, UV + vec2( border_thickness, 0.0));

        bool is_border = (
            up < 0.5 ||
            down < 0.5 ||
            left < 0.5 ||
            right < 0.5
        );

        if (is_border) {
            col.rgb = border_color.rgb;
        }
    }

    COLOR = col;
}
"

