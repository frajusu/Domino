[sub_resource type="Shader" id=6]
code = "shader_type canvas_item;

uniform sampler2D noise_tex : hint_white;
uniform vec4 smoke_color : hint_color = vec4(0.6, 0.2, 1.0, 1.0);
uniform float smoke_size : hint_range(0.5, 10.0) = 2.0;
uniform float speed : hint_range(-5.0, 5.0) = 1.0;
uniform float fade_strength : hint_range(0.0, 2.0) = 1.0;
uniform float alpha_intensity : hint_range(0.0, 1.0) = 0.5;
uniform float pixel_size : hint_range(1.0, 2000.0) = 8.0;
uniform int color_steps : hint_range(1, 64) = 4; // cantidad de niveles de color

void fragment() {
    vec4 base = texture(TEXTURE, UV);

    // pixelar coordenadas UV
    vec2 pixelated_uv = floor(UV * pixel_size) / pixel_size;

    // animar ruido
    vec2 noise_uv = pixelated_uv * smoke_size;
    noise_uv.y -= TIME * 0.1 * speed;

    // obtener ruido
    float n = texture(noise_tex, noise_uv).r;

    // cuantizar el valor de ruido (paleta limitada)
    n = floor(n * float(color_steps)) / float(color_steps);

    // desvanecer hacia arriba
    float fade = clamp(1.0 - UV.y * fade_strength, 0.0, 1.0);

    // humo con alpha y color basado en smoke_color
    vec4 smoke = smoke_color;
    smoke.rgb *= n; // aplicar tono del ruido a la intensidad del color
    smoke.a = n * fade * alpha_intensity;

    // aplicar humo solo si la textura base no es transparente
    smoke *= step(0.001, base.a);

    // mezclar humo sobre la textura base
    COLOR = base + smoke * smoke.a;
    COLOR.a = base.a;
}
"

