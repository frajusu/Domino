[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform sampler2D noise_tex : hint_white;
uniform vec4 layer0_color : hint_color = vec4(0.45,0.15,0.02,1.0);
uniform vec4 layer1_color : hint_color = vec4(0.75,0.25,0.05,1.0);
uniform vec4 layer2_color : hint_color = vec4(0.95,0.45,0.06,1.0);
uniform vec4 layer3_color : hint_color = vec4(1.00,0.85,0.25,1.0);

uniform float pixel_size = 8.0;   // tamaño de bloque visible (ajustalo)
uniform float noise_scale = 4.0;  // cuántas veces se repite el ruido
uniform float speed = 0.2;

uniform float thresh0 = 0.25;
uniform float thresh1 = 0.5;
uniform float thresh2 = 0.75;

void fragment() {
	vec2 tex_size = vec2(1.0 / TEXTURE_PIXEL_SIZE.x, 1.0 / TEXTURE_PIXEL_SIZE.y);
	vec2 pixel_uv = floor(UV * tex_size / pixel_size);

	float t = TIME * speed;
	vec2 noise_uv = pixel_uv / noise_scale + vec2(t * 0.1, -t * 0.05);

	vec2 noise_tex_size = vec2(textureSize(noise_tex, 0));
	ivec2 texel = ivec2(mod(noise_uv * noise_tex_size, noise_tex_size));

	float n = texelFetch(noise_tex, texel, 0).r;

	vec4 color;
	if (n < thresh0)
		color = layer0_color;
	else if (n < thresh1)
		color = layer1_color;
	else if (n < thresh2)
		color = layer2_color;
	else
		color = layer3_color;

	vec4 base = texture(TEXTURE, UV);
	COLOR = vec4(color.rgb, base.a);
}

"

