[sub_resource type="Shader" id=12]
code = "shader_type canvas_item;

uniform vec4 outline_color : hint_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform int outline_size : hint_range(1, 5) = 1;

uniform vec4 original_color : hint_color = vec4(1.0, 1.0, 1.0, 1.0); // color que reemplaza todo el sprite

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);

    vec2 pixel_size = TEXTURE_PIXEL_SIZE;
    bool has_outline = false;

    // Si el pixel es transparente, chequeamos vecinos para el outline
    if (tex_color.a < 0.1) {
        vec2 offsets[4];
        offsets[0] = vec2(float(outline_size), 0.0);   // derecha
        offsets[1] = vec2(-float(outline_size), 0.0);  // izquierda
        offsets[2] = vec2(0.0, float(outline_size));   // abajo
        offsets[3] = vec2(0.0, -float(outline_size));  // arriba

        for (int i = 0; i < 4; i++) {
            vec4 neighbor = texture(TEXTURE, UV + offsets[i] * pixel_size);
            if (neighbor.a > 0.1) {
                has_outline = true;
            }
        }

        if (has_outline) {
            COLOR = outline_color;
        } else {
            COLOR = vec4(0.0);
        }
    } else {
        // Todo el sprite se pinta del color 'original_color'
        COLOR = vec4(original_color.rgb, tex_color.a);
    }
}
"

